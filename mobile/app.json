{
  "expo": {
    "name": "SEYVEO",
    "slug": "seyveo-mobile",
    "scheme": [
      "seyveo",
      "com.seyveo.digitalmanager"
    ],
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.seyveo.digitalmanager",
      "supportsTablet": true
    },
    "android": {
      "package": "com.seyveo.digitalmanager",
      "edgeToEdgeEnabled": true,
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Разрешить SEYVEO использовать Face ID для защиты личного хранилища."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCL": false
        }
      ]
    ],
    "extra": {
      "phase": "M1-security-foundation",
      "cloudBackupEnabled": false,
      "eas": {
        "projectId": "6515d9fd-f2ec-4ffc-baba-0a41747d78f5"
      }
    },
    "owner": "seyveo-official"
  }
}
