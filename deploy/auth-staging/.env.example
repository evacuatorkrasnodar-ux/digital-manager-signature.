# Copy to .env on the staging host only. NEVER commit .env or real passwords.
# Configure DNS A/AAAA records for this hostname first.
SEYVEO_AUTH_HOST=auth-staging.example.invalid
SEYVEO_ACME_EMAIL=operator@example.invalid

# Generate independent secrets with a local CSPRNG, not from this template.
SEYVEO_DB_PASSWORD=REPLACE_WITH_RANDOM_48_CHAR_DB_SECRET
SEYVEO_BOOTSTRAP_ADMIN_USERNAME=seyveo-operator
SEYVEO_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_48_CHAR_ADMIN_SECRET
